# Optional environment variables for the Readwise clone.
# Copy to .env and uncomment any you wish to override.

# Backend port (default: 8000)
# BACKEND_PORT=8000

# Frontend dev server port (default: 3000)
# FRONTEND_PORT=3000

# SMTP ingestion port (default: 2525)
# SMTP_PORT=2525

# JWT signing secret — CHANGE THIS if exposing beyond localhost
# SECRET_KEY=change-me-in-production
