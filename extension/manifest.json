{
  "manifest_version": 3,
  "name": "Readwise Reader — Save Page",
  "version": "1.0",
  "description": "Save the current page to your local Readwise Reader",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost:8000/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Reader"
  }
}
